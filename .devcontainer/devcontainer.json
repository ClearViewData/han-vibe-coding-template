{
  "name": "Vibe coding workshop",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  // 2 cores is genoeg en verbruikt de gratis Codespaces-uren half zo snel als 4.
  "hostRequirements": {
    "cpus": 2
  },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "npm install",
  "postCreateCommand": "",
  "postAttachCommand": {
    "server": "npm start"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "WORKSHOP.md"
      ]
    },
    "vscode": {
      // Laat alleen de AI-assistent staan die we in de workshop gebruiken.
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000]
}
